NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://admin:admin123@mongodb:27017/comconnect?authSource=admin
DB_USERNAME=admin
DB_PASSWORD=admin123
JWT_SECRET=replace-with-a-long-random-secret

REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=comconnect-service
KAFKA_GROUP_ID=message-persistence-group

AI_SERVICE_URL=http://ai-service:5001
AI_SERVICE_TOKEN=replace-with-an-internal-service-token
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

