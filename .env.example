NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

MONGO_URI=mongodb://admin:admin123@mongodb:27017/comconnect?authSource=admin
DB_USERNAME=admin
DB_PASSWORD=admin123
JWT_SECRET=replace-with-a-long-random-secret
INTERNAL_SERVICE_TOKEN=replace-with-an-internal-service-token

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=
REDIS_PASSWORD=
PRESENCE_TTL_SECONDS=75
MESSAGE_STREAM_KEY=chat:messages
MESSAGE_DLQ_STREAM_KEY=chat:messages:dead-letter
MESSAGE_STREAM_CONSUMER_GROUP=message-persistence
MESSAGE_STREAM_MAX_LENGTH=100000
MESSAGE_PERSIST_TIMEOUT_MS=10000
MESSAGE_RESULT_TTL_SECONDS=60
KAFKA_BROKER=kafka:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_GROUP_ID=notification-workers
KAFKA_NOTIFICATION_TOPIC=chat-notifications
KAFKA_SSL=false
KAFKA_USERNAME=
KAFKA_PASSWORD=

AI_SERVICE_URL=http://ai-service:5001
AI_SERVICE_TOKEN=replace-with-an-ai-service-token
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
CHROMA_DIR=/data/chroma
RETRIEVAL_LIMIT=8
WORKSPACE_RAG_MESSAGE_THRESHOLD=200

NOTIFICATION_SERVICE_URL=http://notification-service:5104
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

REACT_APP_API_URL=http://localhost:5000
REACT_APP_SOCKET_URL=http://localhost:5000
